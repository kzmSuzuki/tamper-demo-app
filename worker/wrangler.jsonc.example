{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tamper-classroom-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tamper-classroom",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": { "ALLOWED_ORIGIN": "https://YOUR_GITHUB_USER.github.io" },
  "triggers": { "crons": ["*/15 * * * *"] }
}
