{
  "name": "tamper-classroom-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute DB --local --file=db/schema.sql",
    "dev": "wrangler dev --local --ip 127.0.0.1 --test-scheduled",
    "test:browser": "node --test test/browser.e2e.mjs",
    "lint:frontend": "cd .. && worker/node_modules/.bin/eslint --config worker/eslint.config.mjs frontend/js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "wrangler": "4.160.1"
  }
}
